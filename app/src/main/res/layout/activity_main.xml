<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Reservar una Sala "
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etProfesor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del Profesor (ej: Carolina)"
        android:inputType="textPersonName"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etSala"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Sala Requerida (ej: Sala 101)"
        android:inputType="text"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnReservar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirmar Reserva"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textStyle="italic"
        android:textSize="16sp"
        tools:text="Resultado de la operación"/>

</LinearLayout>